# This file is a TEMPLATE. Copy to .env and fill in values.
# Never commit .env to git.

# ─── Backend (apps/api) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@host/db
REDIS_URL=rediss://default:pass@host:6379

# Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# LLM providers (free-tier keys for MVP)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=     # v1.1 upgrade — leave blank for now
OPENAI_API_KEY=        # v1.1 upgrade — leave blank for now

# Embeddings
JINA_API_KEY=

# External APIs
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Telemetry
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2 (optional at MVP)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Frontend (apps/web) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
